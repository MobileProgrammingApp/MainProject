<?xml version="1.0" encoding="utf-8"?>
<!-- HomePal amblemi (gülen ev). Açılış ekranında kullanılır.
     288dp: Android 12+ arka plansız açılış ikonu boyutu; içerik ortadaki
     192dp'lik daireye sığar (viewport'ta merkezden 72 birim yarıçap).
     Aynı çizim Flutter'da lib/core/widgets/homepal_mark.dart içinde var;
     biri değişirse diğeri de güncellenmeli (açılışta kesintisiz geçiş için). -->
