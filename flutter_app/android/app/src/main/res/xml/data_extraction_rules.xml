<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" bulut yedeğini kapatır ama cihazdan cihaza
     aktarımı kapatmaz. Oturum bilgileri (SharedPreferences ve şifreli depo)
     hiçbir yolla başka cihaza taşınmasın; yeni cihazda tekrar giriş yapılır. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
