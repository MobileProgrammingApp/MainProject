<?xml version="1.0" encoding="utf-8"?>
<!-- Gece modu kapalıyken (gece modu için values-night). Uygulama varsayılan olarak
     telefonun ayarına uyar; açılış ekranı da ona göre açık ya da koyu olur. -->
<resources>
    <!-- Flutter ilk kareyi çizene kadar gösterilen açılış ekranı -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Flutter arayüzünün arkasındaki pencere rengi -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
